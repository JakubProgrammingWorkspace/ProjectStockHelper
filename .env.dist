UID=1000
GID=1000

# Web Server Configuration
WEB_PORT=8000
FRONTEND_PORT=3000

# Project Configuration
PROJECT_NAME=project_stock_helper

# Django Configuration
DJANGO_SECRET_KEY='change-me-generate-a-unique-secret-key'
DEBUG=True
ALLOWED_HOSTS=web,localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:${FRONTEND_PORT},http://127.0.0.1:${FRONTEND_PORT}
# This is dev environment
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database Configuration
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=django_db
DATABASE_USER=django_user
DATABASE_PASSWORD=django_password
DATABASE_HOST=db
DATABASE_PORT=5432

# PostgreSQL Docker Configuration
POSTGRES_DB=django_db
POSTGRES_USER=django_user
POSTGRES_PASSWORD=django_password

# Django Superuser (Optional - for automatic superuser creation)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@admin.net
DJANGO_SUPERUSER_PASSWORD=admin

# Redis Configuration
REDIS_URL=redis://redis:6379/1

# Email Configuration (Optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend


# Media and Static Files
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

APP_NAME=
SEC_EMAIL=

MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_API_KEY=
MASSIVE_API_MINUTE_LIMIT=5

SEC_API_BASE_URL=https://data.sec.gov
SEC_WWW_BASE_URL=https://www.sec.gov
SEC_API_LIMIT=10

# LLM Configuration
LLM_API_MODEL=gpt-4o
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com
# Use http://host.docker.internal:11434 for local Ollama

TIINGO_BASE_URL=https://api.tiingo.com
TIINGO_API_HOURLY_LIMIT=50
TIINGO_API_DAILY_LIMIT=1000
TIINGO_API_TOKEN=

